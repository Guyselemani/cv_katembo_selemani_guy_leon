# Copier ce fichier en .env puis adapter les adresses si besoin

# Adresse de l'API PHP pour Chrome, Edge et Windows
API_URL=http://localhost/api-test/public

# Adresse de l'API pour l'émulateur Android (10.0.2.2 = le PC qui fait tourner XAMPP)
# Sur un vrai téléphone, mettre l'adresse IP du PC, ex. http://192.168.1.10/api-test/public
API_URL_ANDROID=http://10.0.2.2/api-test/public
